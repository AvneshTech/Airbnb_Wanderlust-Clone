<% layout("/layouts/boilerplate.ejs") %>
<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp For WanderLust</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label"><b>Username</b></label>
                <input type="text" placeholder="Enter username" id="username" name="username" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label"><b>Email</b></label>
                <input type="email" placeholder="Enter email" id="email" name="email" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label"><b>Password</b></label>
                <input type="password" placeholder="Enter password" id="password" name="password" class="form-control" required>
            </div>
            <button class="btn btn-dark mb-3">SignUp</button>
        </form>
    </div>
</div>