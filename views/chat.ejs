<% layout("/layouts/boilerplate.ejs") %>

<div class="container mt-4">
    <h2>AI Chatbot</h2>

    <div id="chatbox" class="border p-3 mb-3" style="height:320px; overflow:auto; background:#f8f9fa;">
        <!-- Messages will appear here -->
        <% if (typeof chatHistory !== 'undefined' && chatHistory.length) { %>
            <% for (let msg of chatHistory) { %>
                <% if (msg.role === 'user') { %>
                    <div class="text-end mb-2"><div style="display:inline-block;padding:8px 12px;border-radius:12px;max-width:80%;background:#0d6efd;color:white;"><%= msg.content %></div></div>
                <% } else if (msg.role === 'assistant') { %>
                    <div class="text-start mb-2"><div style="display:inline-block;padding:8px 12px;border-radius:12px;max-width:80%;background:#e9ecef;color:#212529;"><%= msg.content %></div></div>
                <% } %>
            <% } %>
        <% } %>
    </div>

    <form id="chat-form">
        <div class="mb-3">
            <textarea id="message" name="message" class="form-control" rows="3" placeholder="Ask anything..."></textarea>
        </div>
        <button id="sendBtn" class="btn btn-primary" type="submit">Send</button>
        <button id="clearBtn" class="btn btn-secondary ms-2" type="button">Clear</button>
    </form>
</div>

<script src="/js/chat.js"></script>
