# ===== Backend environment variables =====
# Copy this file to ".env" and fill in real values.
# server.js validates ALL of these at boot and refuses to start if any is missing
# (fix for original bug #4: never fail open with a hardcoded fallback secret).

# Express session secret (use a long random string)
SECRET=replace_with_a_long_random_secret

# MongoDB connection string (Atlas or local, e.g. mongodb://127.0.0.1:27017/wanderlust)
ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust

# Cloudinary credentials (image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# OpenAI API key (chat assistant)
OPENAI_API_KEY=sk-your_openai_key

# Frontend origin allowed by CORS (the Vite dev server URL in dev)
CLIENT_URL=http://localhost:5173

# Optional
PORT=8080
NODE_ENV=development
